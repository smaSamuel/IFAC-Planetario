CREATE TABLE IF NOT EXISTS administradores (
	id INT(11) NOT NULL AUTO_INCREMENT, 
    nome VARCHAR(50) NOT NULL,
    email VARCHAR(100) NOT NULL,
	telefone VARCHAR(10) NOT NULL,
    dataNascimento DATE NOT NULL,
    cpf VARCHAR(11) NOT NULL,
    senha VARCHAR(50) NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS usuarios (
  	id INT(11) NOT NULL AUTO_INCREMENT,
    nome VARCHAR(50) NOT NULL,
    email VARCHAR(100) NOT NULL,
    telefone VARCHAR(10) NOT NULL,
    senha VARCHAR(50) NOT NULL,
    PRIMARY KEY (id)
);

CREATE TABLE IF NOT EXISTS monitores (
	id INT(11) NOT NULL AUTO_INCREMENT,
    id_usuario INT(11) NOT NULL,
    tipo VARCHAR(30) NOT NULL,
    dataNascimento DATE NOT NULL,
    cpf VARCHAR(11) NOT NULL,
    PRIMARY KEY(id),
    FOREIGN KEY (id_usuario) REFERENCES usuarios (id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS cliente_pessoaFisica(
    id INT(11) NOT NULL AUTO_INCREMENT,
    id_usuario INT(11) NOT NULL,
    dataNascimento DATE NOT NULL,
    cpf VARCHAR (11) NOT NULL,
    PRIMARY KEY (id),
    FOREIGN KEY (id_usuario) REFERENCES usuarios (id) ON DELETE CASCADE
);    

CREATE TABLE IF NOT EXISTS cliente_pessoaJuridica(
    id INT(11) NOT NULL AUTO_INCREMENT,
    id_usuario INT(11) NOT NULL,
    cnpj VARCHAR (14) NOT NULL,
    PRIMARY KEY (id),
    FOREIGN KEY (id_usuario) REFERENCES usuarios (id) ON DELETE CASCADE
);    

CREATE TABLE IF NOT EXISTS solicitacoes_assistentes (
  	id INT (11) NOT NULL AUTO_INCREMENT,
    id_monitor INT (11),
    diaAssistencia DATETIME NOT NULL,
    diaSolicitacao DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
    PRIMARY KEY (id),
    FOREIGN KEY (id_monitor) REFERENCES monitores (id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS horarios (
  	id INT(11) NOT NULL AUTO_INCREMENT,
    id_monitor INT (11),
    dataHorario DATETIME NOT NULL DEFAULT CURRENT_TIME,
    PRIMARY KEY (id),
    FOREIGN KEY (id_monitor) REFERENCES monitores (id) ON DELETE SET NULL
);

CREATE TABLE IF NOT EXISTS reservaEspaco(
  	id INT(11) NOT NULL AUTO_INCREMENT,
    id_horario INT (11) NOT NULL,
    id_pessoaJuridica INT (11) NOT NULL,
    PRIMARY KEY (id),
    FOREIGN KEY (id_horario) REFERENCES horarios (id) ON DELETE CASCADE
    FOREIGN KEY (id_pessoaJuridica) REFERENCES horarios (id) ON DELETE CASCADE
);

CREATE TABLE IF NOT EXISTS visitas_horario (
  	id INT(11) NOT NULL AUTO_INCREMENT,
    id_horario INT (11) NOT NULL,
    id_cliente_pessoaFisica INT(11) NOT NULL,
    PRIMARY KEY (id),
    FOREIGN KEY (id_horario) REFERENCES horarios (id) ON DELETE CASCADE,
    FOREIGN KEY (id_cliente_pessoaFisica) REFERENCES cliente_pessoaJuridica (id) ON DELETE CASCADE
);
